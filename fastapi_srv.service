
[Unit]
Description=FastAPI Taller 3 - MLOps
After=network.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/MLOps-FastAPI-taller3
ExecStart=/home/ubuntu/miniconda3/envs/fastapi/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
